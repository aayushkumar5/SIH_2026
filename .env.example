# IBVAP Environment Configuration

# Application
APP_NAME=IBVAP
APP_ENV=development
SECRET_KEY=supersecretkey-ibvap-sih26187-border-security-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_V1_STR=/api/v1

# Database (Default: SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./ibvap.db
# DATABASE_URL=postgresql://ibvap_user:ibvap_pass@localhost:5432/ibvap_db

# Edge / BOP Configuration
BOP_ID=BOP-DHARCHULA-01
EDGE_SYNC_INTERVAL_SECONDS=5
EDGE_LOCAL_DB=sqlite:///./edge_local.db
CENTRAL_API_URL=http://localhost:8000/api/v1

# Storage
STORAGE_DIR=./storage
SNAPSHOT_DIR=./storage/snapshots
CLIP_DIR=./storage/clips

# AI / Inference Settings
AI_CONFIDENCE_THRESHOLD=0.5
AI_DEVICE=cpu # 'cpu' or 'cuda'
ANPR_OCR_THRESHOLD=0.6
FACE_MATCH_THRESHOLD=0.65
ENABLE_NIGHT_ENHANCEMENT=true
NIGHT_START_HOUR=18
NIGHT_END_HOUR=6

# Logging
LOG_LEVEL=INFO
